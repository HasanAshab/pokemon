modules = ["nodejs-20", "web", "python-3.12"]
run = "python -m http.server 5000 --bind 0.0.0.0"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "python -m http.server 5000 --bind 0.0.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Dev Server"

[[workflows.workflow]]
name = "Dev Server"
author = 39836168
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m http.server 5000 --bind 0.0.0.0 --directory . --reload"
